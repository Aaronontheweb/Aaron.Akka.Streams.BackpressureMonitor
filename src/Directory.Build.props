<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Copyright>Copyright © 2020-$([System.DateTime]::Now.Year) Aaron Stannard</Copyright>
    <Authors>Aaronontheweb</Authors>
    <VersionPrefix>0.2.0</VersionPrefix>
    <PackageReleaseNotes>Upgraded to Akka.NET v1.5.38
Updated all test dependencies to latest versions:
- Microsoft.NET.Test.Sdk to 17.13.0
- xunit to 2.9.3
- xunit.runner.visualstudio to 2.5.7
- coverlet.collector to 6.0.4
Fixed breaking changes in Akka.NET 1.5.x:
- Updated `OnDownstreamFinish` to handle exceptions
- Updated logging API calls to match new format</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Aaronontheweb/Aaron.Akka.Streams.BackpressureMonitor</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Target Framework Settings -->
  <PropertyGroup>
    <LibraryFramework>netstandard2.1</LibraryFramework>
    <TestsNetCoreFramework>net8.0</TestsNetCoreFramework>
  </PropertyGroup>
  <!-- Deterministic Build Settings -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- SourceLink Support -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <!-- Include README in NuGet package -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>